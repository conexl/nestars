# Telegram bot token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# MongoDB is configured in docker-compose.yml, keep these defaults for Docker
# MONGO_URI=mongodb://mongo:27017
# MONGO_DB=nestars_bot

# Backend (Fragment API) URL inside Docker network
# BACKEND_URL=http://fragment:8000

# Optional UI links used by bot keyboards
SUPPORT_URL=https://t.me/your_support
NEWS_CHANNEL_URL=https://t.me/your_channel

# Mini App URL shown in the bot menu (must be publicly reachable HTTPS in production)
MINIAPP_URL=https://your-domain.com
MINIAPP_PORT=8080
